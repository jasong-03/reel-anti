# LLM provider for the agent route. The provider is swappable (see lib/agent/llm.ts):
# OpenRouter, Gemini Developer API, Vertex (gcloud ADC), or a custom OpenAI-compatible gateway.

# --- Option A: OpenRouter (OpenAI-compatible tool calling) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_MODEL=google/gemini-2.5-flash   # any tool-calling model on OpenRouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Option B: Gemini Developer API ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# --- Option C: Vertex AI via gcloud ADC (no key; bills your GCP project) ---
# LLM_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=gfi-455410
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Option D: BEEP / other OpenAI-compatible gateway ---
# LLM_PROVIDER=beep
# BEEP_API_KEY=beep_sk_...
# BEEP_BASE_URL=https://your-gateway/v1
# BEEP_MODEL=google/gemini-2.5-flash

# --- MCP server (W1: let Claude Code / Cursor / Codex drive the timeline) ---
# Shared secret that gates POST /api/mcp. UNSET = endpoint disabled (safe default).
# MCP_TOKEN=choose-a-long-random-string

# --- Generative media (W4: generate_image / generate_video) ---
# Uses GEMINI_API_KEY (Imagen + Veo). For offline/dev without spending credits:
# MEDIA_GEN_PROVIDER=stub
